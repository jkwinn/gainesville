# Copy to a server-only env file. Do not commit real secrets.

# Service account with read access to the Google Calendar:
# gainesvill-sa@copper-freedom-165318.iam.gserviceaccount.com

GOOGLE_APPLICATION_CREDENTIALS=/etc/gainesville/google-calendar-service-account.json
GAINESVILLE_CALENDAR_ID=gainesvilletheband@gmail.com
GAINESVILLE_OUTPUT_JSON=/var/www/gainesville/data/shows.json
GAINESVILLE_IMAGE_DIR=/var/www/gainesville/assets/calendar
GAINESVILLE_IMAGE_PUBLIC_PREFIX=assets/calendar
GAINESVILLE_EVENT_PREFIX=Gig:
GAINESVILLE_TIMEZONE=America/Los_Angeles
GAINESVILLE_LOOKBACK_DAYS=365
GAINESVILLE_LOOKAHEAD_DAYS=730
